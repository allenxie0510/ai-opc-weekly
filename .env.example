# Existing Supabase client configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Product Radar: explicitly set false to hide the navigation entry and return 404 for tool routes.
XHS_PRODUCT_RADAR_ENABLED=true
NEXT_PUBLIC_XHS_PRODUCT_RADAR_ENABLED=true

# fixture is the safe default. live reads normalized, published payloads from Supabase and falls back to fixtures on provider failure.
PRODUCT_RADAR_DATA_MODE=fixture

# Required only by `npm run pipeline:product-radar -- --persist`; never expose this key to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Reserved adapter credentials. Do not configure unofficial cookies or login-session scraping.
XHS_AUTHORIZED_PROVIDER_KEY=
ALIBABA_1688_PROVIDER_KEY=
